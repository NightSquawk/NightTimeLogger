{
  "name": "ntlogger",
  "version": "4.0.0",
  "description": "Structured logging with Winston and Pino backends",
  "keywords": [
    "custom logger",
    "discord compatible",
    "fastify logger",
    "log management",
    "logger",
    "logger wrapper",
    "logging",
    "logging utility",
    "mysql compatible",
    "opentelemetry",
    "otel",
    "otlp",
    "pino transport",
    "sentry compatible",
    "syslog compatible",
    "teams compatible",
    "winston logger",
    "winston wrapper",
    "wrapper"
  ],
  "author": "Kevin R. (Kvrnn#6940, Syntax#5569)",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NightSquawk/NightTimeLogger.git"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./pino": {
      "types": "./pino.d.ts",
      "default": "./pino.js"
    },
    "./package.json": "./package.json",
    "./eslint": {
      "types": "./eslint.d.ts",
      "default": "./eslint.js"
    },
    "./contract/redaction.json": "./contract/redaction.json",
    "./contract/conformance.json": "./contract/conformance.json"
  },
  "types": "./index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "pino.js",
    "pino.d.ts",
    "lib/*.js",
    "plugins/**/*",
    "transports/",
    "eslint.js",
    "eslint.d.ts",
    "eslint-rules/",
    "contract/"
  ],
  "scripts": {
    "test": "jest",
    "test:coverage": "jest --runInBand --coverage",
    "test:unit": "jest --runInBand --testPathIgnorePatterns=tests/plugins/mysql.test.js tests/plugins/postgres.test.js",
    "test:package": "node scripts/test-package.cjs",
    "test:python": "python3 -W error -m unittest discover -s python/tests",
    "test:contract": "node scripts/sync-python-contract.cjs --check"
  },
  "optionalDependencies": {
    "split2": "^4.2.0"
  },
  "peerDependencies": {
    "@opentelemetry/api": ">=1.9.0",
    "@opentelemetry/api-logs": "^0.222.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-logs": "^0.222.0",
    "@opentelemetry/semantic-conventions": ">=1.20.0",
    "@sentry/node": "^10.74.0",
    "mysql2": "^3.24.4",
    "pg": "^8.23.0",
    "pino": ">=9.14.0",
    "winston": "^3.19.0",
    "winston-transport": "^4.9.0",
    "eslint": ">=9.0.0"
  },
  "peerDependenciesMeta": {
    "pino": {
      "optional": true
    },
    "@sentry/node": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "@opentelemetry/api": {
      "optional": true
    },
    "@opentelemetry/api-logs": {
      "optional": true
    },
    "@opentelemetry/sdk-logs": {
      "optional": true
    },
    "@opentelemetry/exporter-logs-otlp-http": {
      "optional": true
    },
    "@opentelemetry/resources": {
      "optional": true
    },
    "@opentelemetry/semantic-conventions": {
      "optional": true
    },
    "winston": {
      "optional": true
    },
    "winston-transport": {
      "optional": true
    },
    "eslint": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opentelemetry/context-async-hooks": "^2.11.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.222.0",
    "@opentelemetry/sdk-logs": "^0.222.0",
    "@sentry/node": "^10.74.0",
    "@sentry/profiling-node": "^10.74.0",
    "@testcontainers/mysql": "^12.1.0",
    "@testcontainers/postgresql": "^12.1.0",
    "dotenv": "^18.0.0",
    "eslint": "^10.10.0",
    "fastify": "^5.12.4",
    "jest": "^30.5.1",
    "mysql2": "^3.24.4",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "testcontainers": "^12.1.0",
    "typescript": "^5.9.3",
    "winston": "^3.19.0",
    "winston-transport": "^4.9.0"
  },
  "engines": {
    "node": ">=22.22.2"
  }
}

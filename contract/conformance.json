    {
      "input": "eyJabcdef.abcdefgh.abcdefgh",
      "expected": "[REDACTED]"
    },
    {
      "input": "ghp_aaaaaaaaaaaaaaaaaaaaaaaa",
      "expected": "[REDACTED]"
    },
    {
      "input": "xoxb-aaaaaaaaaaaa",
